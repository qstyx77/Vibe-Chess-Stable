
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the Evolving Chess game.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "username": {
          "type": "string",
          "description": "The user's username."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "eloRating": {
          "type": "number",
          "description": "The user's Elo rating."
        },
        "wins": {
          "type": "number",
          "description": "Total number of wins."
        },
        "losses": {
          "type": "number",
          "description": "Total number of losses."
        },
        "inventory": {
          "type": "array",
          "description": "Current items in the player's bag.",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "count": { "type": "number" }
            }
          }
        },
        "equipment": {
          "type": "object",
          "description": "Mapping of piece IDs to equipped item types.",
          "additionalProperties": { "type": "string" }
        },
        "dungeonState": {
          "type": "object",
          "description": "Saved state of the player's current dungeon run.",
          "properties": {
            "level": { "type": "number" },
            "board": { "type": "array" },
            "currentPlayer": { "type": "string" },
            "killStreaks": { "type": "object" },
            "capturedPieces": { "type": "object" },
            "shroomSpawnCounter": { "type": "number" },
            "nextShroomSpawnTurn": { "type": "number" },
            "enPassantTargetSquare": { "type": ["string", "null"] }
          }
        },
        "lastActive": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the user's last interaction for presence tracking."
        },
        "unlockedPieces": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": [
        "id",
        "username",
        "email",
        "eloRating",
        "wins",
        "losses"
      ]
    },
    "Friend": {
      "title": "Friend",
      "type": "object",
      "description": "Represents a friendship relationship.",
      "properties": {
        "id": { "type": "string", "description": "The UID of the friend." },
        "username": { "type": "string" },
        "status": { "type": "string", "enum": ["accepted", "pending", "blocked"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user data. Access is restricted to the user identified by {userId}."
        }
      },
      {
        "path": "/users/{userId}/friends/{friendId}",
        "definition": {
          "entityName": "Friend",
          "schema": {
            "$ref": "#/backend/entities/Friend"
          },
          "description": "Stores a user's friends list."
        }
      },
      {
        "path": "/leaderboard/{leaderboardId}",
        "definition": {
          "description": "Public leaderboard data.",
          "schema": { "type": "object" }
        }
      }
    ],
    "reasoning": "Standard user and social structure using path-based ownership for friends and global read access for basic user profiles."
  }
}
